# Gmail SMTP credentials used to email quote requests (from /quote) to your inbox.
# 1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords (choose "Mail")
# 3. Paste that 16-character app password below (NOT your normal Gmail password).
GMAIL_USER=forgedsportswearcanada@gmail.com
GMAIL_APP_PASSWORD=

# Optional: where quote request emails are sent. Defaults to GMAIL_USER if unset.
QUOTE_TO_EMAIL=forgedsportswearcanada@gmail.com

# Stripe secret key, used by /pay to create Checkout Sessions.
# Get it from https://dashboard.stripe.com/apikeys (use the "sk_test_..." key while testing).
STRIPE_SECRET_KEY=
